{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/tutor.js": {
      "maxDuration": 60,
      "includeFiles": "skills/tutor/**"
    },
    "api/harness.js": {
      "maxDuration": 60,
      "includeFiles": "skills/tutor/**"
    }
  },
  "rewrites": [
    {
      "source": "/harness/v1/chat/completions",
      "destination": "/api/harness"
    }
  ]
}

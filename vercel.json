{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/tutor.js": {
      "maxDuration": 60,
      "includeFiles": "{skills/tutor/**,public/research-feed.json}"
    },
    "api/harness.js": {
      "maxDuration": 60,
      "includeFiles": "{skills/tutor/**,public/research-feed.json}"
    },
    "api/research.js": {
      "maxDuration": 15,
      "includeFiles": "public/research-feed.json"
    },
    "api/research-refresh.js": {
      "maxDuration": 60,
      "includeFiles": "public/research-feed.json"
    }
  },
  "rewrites": [
    {
      "source": "/harness/v1/chat/completions",
      "destination": "/api/harness"
    }
  ],
  "crons": [
    {
      "path": "/api/research-refresh",
      "schedule": "0 2 * * *"
    }
  ]
}

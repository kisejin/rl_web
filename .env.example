# Server-only settings. Never prefix secrets with VITE_.
QWENCODER_API_KEY=
QWENCODER_BASE_URL=https://api.qwencoder.cloud/api/v1
QWENCODER_MODEL=qwen3.8-flash

# Optional: activate only after deploying the Docker runtime behind HTTPS.
# Leave empty to keep the current direct provider backend.
DEEPSEEK_HARNESS_URL=
DEEPSEEK_HARNESS_TOKEN=
